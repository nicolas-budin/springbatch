<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Le "parent" Spring Boot fixe les versions de toutes les dépendances Spring
         (Spring Boot 1.5.x embarque Spring Batch 3.0.x et Spring Framework 4.3.x) :
         on n'a donc pas besoin d'indiquer de version sur les dépendances ci-dessous. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>1.5.22.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>hello-batch</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hello-batch</name>
    <description>Hello World Spring Batch</description>

    <properties>
        <!-- Spring Batch 3 / Spring Boot 1.5 datent de l'époque de Java 8 :
             on compile donc du code Java 8 (lambdas oui, var / List.of / record non). -->
        <java.version>1.8</java.version>
        <!-- Options JVM supplémentaires : vides en Java 8, remplies par le profil
             "jdk9-et-plus" ci-dessous quand on utilise un JDK plus récent. -->
        <jvm.args></jvm.args>
    </properties>

    <dependencies>
        <!-- Spring Batch + son auto-configuration Spring Boot
             (création des tables, lancement du job au démarrage...). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <!-- Spring Batch stocke l'état des jobs (JobRepository) dans une base :
             H2 en mémoire suffit pour apprendre. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Les annotations javax.annotation (@PostConstruct, @Resource...) faisaient partie
             du JDK jusqu'à Java 10, puis ont été retirées. Spring Boot 1.5 s'en sert
             notamment pour créer les tables BATCH_* (méthode @PostConstruct de
             BatchDatabaseInitializer). Sans cette dépendance, sur un JDK 11+, Spring ignore
             l'annotation sans rien dire, les tables ne sont pas créées et le job échoue avec
             "Table BATCH_JOB_INSTANCE not found". (Inutile mais sans danger en Java 8.) -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <!-- Tests : JUnit 4, AssertJ, support de test Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Outils de test Spring Batch : JobLauncherTestUtils... -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Permet "mvn spring-boot:run" et construit un jar exécutable ("mvn package"). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>${jvm.args}</jvmArguments>
                </configuration>
            </plugin>
            <!-- Exécute les tests ("mvn test") avec les mêmes options JVM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${jvm.args}</argLine>
                </configuration>
            </plugin>
            <!-- "Add-Opens" dans le manifeste : même rôle que l'option de ligne de commande
                 (voir le profil ci-dessous), mais pour "java -jar". Java 8 l'ignore. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Add-Opens>java.base/java.lang java.base/java.lang.reflect java.base/java.util java.base/java.text java.desktop/java.awt.font</Add-Opens>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Des bibliothèques de l'époque de Spring Batch 3 accèdent par réflexion à l'intérieur
             du JDK :
               - Spring Framework 4.3 génère des classes à la volée (proxies CGLIB, par exemple
                 pour @Configuration et @StepScope) via une méthode interne de java.lang ;
               - XStream, que Spring Batch 3 utilise pour enregistrer les ExecutionContext en
                 base (tables BATCH_*_EXECUTION_CONTEXT), lit les champs privés de classes
                 de java.util, java.lang.reflect, java.text...
             Depuis Java 16, le JDK l'interdit par défaut : il faut l'autoriser explicitement,
             package par package, avec "add-opens".
             Ce profil s'active tout seul avec un JDK 9 ou plus récent ; en Java 8, l'option
             n'existe pas (la JVM refuserait de démarrer), d'où ce profil conditionnel. -->
        <profile>
            <id>jdk9-et-plus</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <jvm.args>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.text=ALL-UNNAMED --add-opens java.desktop/java.awt.font=ALL-UNNAMED</jvm.args>
            </properties>
        </profile>
    </profiles>
</project>
