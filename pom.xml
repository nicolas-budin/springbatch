<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Le "parent" Spring Boot fixe les versions de toutes les dépendances Spring
         (Spring Boot 3.5.x embarque Spring Batch 5.2.x) : on n'a donc pas besoin
         d'indiquer de version sur les dépendances ci-dessous. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>hello-batch</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hello-batch</name>
    <description>Hello World Spring Batch</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring Batch + son auto-configuration Spring Boot
             (JobRepository, JobLauncher, lancement du job au démarrage...). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <!-- Spring Batch 5 stocke l'état des jobs (JobRepository) dans une base :
             H2 en mémoire suffit pour apprendre. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests : JUnit 5, AssertJ, support de test Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Outils de test Spring Batch : @SpringBatchTest, JobLauncherTestUtils... -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Permet "mvn spring-boot:run" et construit un jar exécutable ("mvn package"). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
